# PostgreSQL bağlantı adresi (Neon, Supabase, Railway vb.)
# Neon/Supabase kullanıyorsanız "pooled" bağlantı adresini kullanın.
DATABASE_URL="postgresql://user:password@host:5432/tezgahci?sslmode=require"

# NextAuth için rastgele, uzun bir gizli anahtar.
# Üretmek için: openssl rand -base64 32
NEXTAUTH_SECRET="buraya-uzun-rastgele-bir-anahtar-yazin"

# Sitenin canlı adresi (yerelde http://localhost:3000)
NEXTAUTH_URL="https://tezgahci.com.tr"

# Fotoğraf yükleme için Vercel Blob token'ı (Vercel projenizde Storage > Blob'dan alınır).
# Tanımlı değilse ilan fotoğrafı yükleme özelliği devre dışı kalır, site yine çalışır.
BLOB_READ_WRITE_TOKEN=""

# İlk kurulumda admin panele girmek için kullanılacak kullanıcı adı.
# prisma/seed.ts bu kullanıcıyı isAdmin=true olarak oluşturur.
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="degistir-bu-sifreyi-123"
