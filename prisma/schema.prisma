generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BIREYSEL
  BAYI
}

enum ListingCondition {
  SIFIR
  IKINCI_EL
  YENILENMIS
}

enum Currency {
  TRY
  USD
  EUR
}

enum AdPlacement {
  HOME_SEARCH_BANNER
  HOME_AFTER_VITRIN
  HOME_SERVICE_CARD
  LISTING_TOP_BANNER
  LISTING_INFEED
  LISTING_SIDEBAR
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  accountType  AccountType @default(BIREYSEL)
  fullName     String?
  companyName  String?
  phone        String?
  city         String?
  approved     Boolean  @default(true)
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Bayi ekip yönetimi: bir bayi hesabı, kendi ekibine (örn. "Müşteri Temsilcisi")
  // ayrı giriş bilgileriyle alt hesaplar tanımlayabilir. Alt hesabın
  // parentDealerId'si, sahibi olan bayi hesabına işaret eder; sahip hesapların
  // parentDealerId'si null'dur. role, alt hesabın unvanını tutar (örn.
  // "Müşteri Temsilcisi"); sahip hesaplarda null'dur.
  parentDealerId String?
  parentDealer   User?   @relation("DealerTeam", fields: [parentDealerId], references: [id], onDelete: Cascade)
  teamMembers    User[]  @relation("DealerTeam")
  role           String?

  // Bayi markalaşma + kayıt evrakları: logoUrl bayi panelinden yüklenir ve
  // ilan detayı/bayi panelinde gösterilir. activityCertificateUrl (güncel
  // faaliyet belgesi) ve signatureCircularUrl (imza sirküleri) kayıt
  // formunda BAYI hesapları için zorunludur; yönetici onay vermeden önce
  // Bayiler panelinden inceler.
  logoUrl                 String?
  activityCertificateUrl  String?
  signatureCircularUrl    String?

  listings         Listing[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  @@index([parentDealerId])
  @@map("users")
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  category    String
  brand       String?
  model       String?
  year        Int?
  condition   ListingCondition @default(IKINCI_EL)
  controller  String?
  axisCount   String?
  workArea    String?
  price       Int
  currency    Currency @default(TRY)
  city        String
  description String   @db.Text
  isSold      Boolean  @default(false)
  isVitrin    Boolean  @default(false)
  // Satıcı (yalnızca Bayi hesapları), ilan fotoğraflarının "Makine Önizleme"
  // panelinde marka/model bazlı olarak gösterilmesine bu alanla izin verir.
  // Varsayılan false'tur — açık onay olmadan hiçbir ilan önizlemede görünmez.
  previewConsent Boolean @default(false)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  images   ListingImage[]
  messages Message[]

  @@index([category])
  @@index([city])
  @@index([sellerId])
  @@index([createdAt])
  @@map("listings")
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  order     Int     @default(0)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model Message {
  id         String   @id @default(cuid())
  body       String   @db.Text
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  senderId   String
  sender     User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([receiverId])
  @@index([senderId])
  @@map("messages")
}

// Reklam yönetimi: yönetici panelinden ("Reklamlar") oluşturulan, ana sayfa ve
// ilan listelerindeki belirli alanlarda gösterilen sponsorlu reklamlar.
model Ad {
  id              String      @id @default(cuid())
  advertiserName  String
  imageUrlDesktop String
  // Mobil görsel verilmezse masaüstü görseli mobilde de kullanılır.
  imageUrlMobile  String?
  altText         String
  targetUrl       String
  placement       AdPlacement
  // null = tüm kategorilerde gösterilir; bir kategori anahtarı verilirse
  // yalnızca o kategori bağlamında (ör. ilan listesinde kategori filtresi)
  // gösterilir.
  category        String?
  startDate       DateTime?
  endDate         DateTime?
  // Aynı alanda birden fazla aktif reklam varsa ağırlıklı rastgele seçim
  // (rotasyon) için kullanılır. Yüksek sayı = daha sık gösterim.
  priority        Int         @default(1)
  active          Boolean     @default(true)
  impressions     Int         @default(0)
  clicks          Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([placement])
  @@index([category])
  @@map("ads")
}
